# W2Health Intelligence — variáveis de ambiente (Docker Compose)
# Copie para .env e ajuste se necessário. Todos os valores têm default no compose.

# PostgreSQL
POSTGRES_USER=w2health
POSTGRES_PASSWORD=w2health
POSTGRES_DB=w2health
# Porta no host. 15432: a máquina já tem PostgreSQL nativo em 5432 e 5433.
POSTGRES_PORT=15432

# Portas expostas no host
# Backend em 8010: o Docker Desktop ocupa a 8000 nesta máquina.
BACKEND_PORT=8010
FRONTEND_PORT=3000

# Backend — origens de CORS. É uma coleção: informe como array JSON válido.
CORS_ORIGINS=["http://localhost:3000"]

